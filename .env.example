# Copie para .env; este arquivo nao contem credenciais.
APP_MODE=demo
MODEL_ID=gpt-6.1-sol

# Origem HTTPS publica da aplicacao em producao; obrigatoria para deploy live.
APP_ORIGIN=https://pi.example.com
COOKIE_SECURE=true

# Obrigatoria em runtime: escolha uma senha longa (minimo 12 caracteres).
# No Coolify, marque como runtime e desabilite build-time. Nao inclua no Git.
WEB_PASSWORD=

# Opcional: habilite MCP montando um arquivo revisado em docker-compose.yml.
MCP_CONFIG_FILE=

# Telegram é configurado explicitamente em botão Telegram no cabeçalho da conversa na aplicação.
# Estas variáveis antigas são somente dicas de migração; não iniciam o bot.
# O token só pode ser reutilizado quando o operador escolhe Conectar e deixa
# o campo de token vazio. Não preencha allowlists nem segredo de webhook para a UI nova.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN_FILE=/caminho/seguro/telegram_bot_token
# TELEGRAM_BOT_USERNAME=   # legado; não necessário para polling
# TELEGRAM_WEBHOOK_SECRET= # obsoleto na UI nova
# TELEGRAM_ALLOWED_USERS=  # obsoleto na UI nova
# TELEGRAM_ALLOWED_CHATS=  # obsoleto na UI nova

# Alternativa por arquivo: somente com docker-compose.secrets.yml.
# WEB_PASSWORD_SECRET_FILE=/caminho/seguro/pi-agent/web_password
# TELEGRAM_BOT_TOKEN_SECRET_FILE=/caminho/seguro/pi-agent/telegram_bot_token
# TELEGRAM_WEBHOOK_SECRET_FILE=/caminho/seguro/pi-agent/telegram_webhook_secret # legado
