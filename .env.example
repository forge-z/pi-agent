# Copie para .env; este arquivo nao contem credenciais.
APP_MODE=demo
MODEL_ID=gpt-6.1-sol

# Origem HTTPS publica da aplicacao em producao; obrigatoria para deploy live.
APP_ORIGIN=https://pi.example.com
COOKIE_SECURE=true

# Obrigatoria em runtime: escolha uma senha longa (minimo 12 caracteres).
# No Coolify, marque como runtime e desabilite build-time. Nao inclua no Git.
WEB_PASSWORD=

# Opcional: habilite MCP montando um arquivo revisado em docker-compose.yml.
MCP_CONFIG_FILE=

# Opcional: segredos somente em runtime. Sem token, Telegram fica desabilitado.
TELEGRAM_BOT_TOKEN=
# Username público do seu bot, sem @. Opcional: habilita link de abertura e sufixos @bot.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_CHATS=

# Alternativa por arquivo: somente com docker-compose.secrets.yml.
# WEB_PASSWORD_SECRET_FILE=/caminho/seguro/pi-agent/web_password
# TELEGRAM_BOT_TOKEN_SECRET_FILE=/caminho/seguro/pi-agent/telegram_bot_token
# TELEGRAM_WEBHOOK_SECRET_FILE=/caminho/seguro/pi-agent/telegram_webhook_secret
